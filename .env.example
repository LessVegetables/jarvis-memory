# Copy to .env (gitignored) and fill in. Real environment variables win over
# this file, so systemd/cron can override anything here.

# weatherapi.com -- free tier is enough. https://www.weatherapi.com/my/
WEATHERAPI_KEY=

# 2GIS Catalog API key. https://dev.2gis.ru/
DGIS_KEY=

# Where the device lives. Both weather and places are relative to this.
JARVIS_LAT=55.7539
JARVIS_LON=37.6208

# Seconds to wait for any HTTP call before giving up. Keep it short: the
# person is already waiting through STT + LLM + TTS.
JARVIS_HTTP_TIMEOUT=3

# Database location (defaults to ./jarvis.db).
# JARVIS_DB=/home/firefly/jarvis.db

# Calendar passwords referenced by password_env in calendars.json go here, never
# inline in that file. iCloud needs an APP-SPECIFIC password from
# appleid.apple.com -- the account password will not work with two-factor on.
# DANIEL_ICLOUD_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# --- Spotify playback -------------------------------------------------------
# https://developer.spotify.com/dashboard -> Create app. Add exactly this
# redirect URI to the app: http://127.0.0.1:8888/callback
# Then run `python3 tools/spotify_auth.py` ON A LAPTOP once and paste the
# refresh token it prints below. The board never needs a browser.
# Playback needs Premium and the Spotify app open somewhere -- the Web API
# will not start playing on a device that is not already running.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# --- intent fallback --------------------------------------------------------
# Set to 0 to stop the memory module calling the LLM to classify phrases the
# regexes did not match. It then behaves exactly as before: those phrases are
# answered as general conversation. Worth knowing during a shared demo -- if
# the LLM server is struggling, this is the first thing to switch off.
JARVIS_LLM_INTENT=1

# Where that call goes. Defaults match the orchestrator's own, so normally
# neither needs setting.
# JARVIS_LLM_URL=http://localhost:8080/v1/chat/completions
# JARVIS_LLM_MODEL=rkllm
